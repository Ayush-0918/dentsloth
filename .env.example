# ============================================================
# DentSloth – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- App ---
APP_ENV=development
DEMO_MODE=true
LOG_LEVEL=INFO

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=dentsloth

# --- LLM Provider ---
# "ollama"  = local Ollama (images stay on your machine)
# "hosted"  = Google AI Studio / Gemma API (public deploy)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
GEMMA_API_KEY=

# --- TabPFN Pricing ---
TABPFN_MODE=local
TABPFN_API_KEY=

# --- Embedding ---
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text

# --- Upload ---
MAX_UPLOAD_MB=10

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Sentry Agent Tracing & Debug ---
SENTRY_DSN=
ENABLE_DEBUG=false
